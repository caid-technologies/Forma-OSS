!.python-version
!requirements.txt
!main.py
!apps
!apps/__init__.py
!apps/api
!apps/api/**
!blueprint_core
!blueprint_core/**
!apps/web
!apps/web/**

.git
.vercel
.env
.env.*
.agents
.claude
.codex
skills-lock.json

node_modules
apps/web/node_modules
.next
apps/web/.next
out
build
dist
*.tsbuildinfo

.venv
venv
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache

*.db
*.log
.logs
.blueprint
.spacebase
tmp
data

.DS_Store
